{
  "name": "portfolio",
  "version": "1.0.0",
  "type": "module",
  "description": "My Portfolio website",
  "main": "index.js",
  "scripts": {
    "sync-content": "mkdir -p content && cp -f ../content/site-content.json content/site-content.json 2>/dev/null || true",
    "predev": "npm run sync-content",
    "prebuild": "npm run sync-content",
    "build": "vite build",
    "start": "node server.js",
    "postinstall": "npm run build",
    "dev": "vite",
    "test": "vitest run",
    "pretest": "npm run sync-content",
    "lint": "eslint .",
    "e2e": "npm run build && playwright test"
  },
