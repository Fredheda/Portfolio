    "express-rate-limit": "^7.5.1",
    "highlight.js": "~11.12.0",
    "katex": "^0.19.1",
    "lowlight": "^3.3.0",
    "mermaid": "11.17.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
